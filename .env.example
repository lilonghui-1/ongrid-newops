# ============================================
# 环境变量模板 - 复制为 .env 并按需填写
# 配置加载时 ${VAR} 占位符会替换为环境变量值
# ============================================

# ---------- LLM ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# ---------- SSH ----------
SSH_PRIVATE_KEY_PATH=
LINUX_SSH_PASSWORD=
WIN_SERVER_PASSWORD=
KYLIN_SSH_PASSWORD=
UOS_SSH_PASSWORD=

# ---------- 数据库 ----------
MYSQL_PASSWORD=
PG_PASSWORD=
REDIS_PASSWORD=
ORACLE_PASSWORD=
DM_PASSWORD=
KINGBASE_PASSWORD=

# ---------- 通知（企微/钉钉） ----------
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---------- 即时通讯（飞书/Telegram/Slack） ----------
LARK_WEBHOOK=
LARK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK=

# ---------- 可观测性 ----------
PROMETHEUS_URL=
LOKI_URL=
GRAFANA_URL=

# ---------- 邮件 ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# ---------- 日志平台 ----------
ES_URL=
ES_USERNAME=
ES_PASSWORD=

# ---------- Web ----------
OPS_AGENT_SECRET_KEY=change-me-in-production

# ---------- MCP ----------
MCP_HTTP_TOKEN=